{
  "name": "PutWatch",
  "short_name": "PutWatch",
  "description": "Automatic per-tracker seeding time & ratio rule engine for Put.io",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#020617",
